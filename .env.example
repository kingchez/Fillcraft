# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# Supabase (recommended — source of truth for template metadata + storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret n8n must send as the "x-api-key" header when calling
# /api/templates/:id/autofill and /api/images/normalize.
# Leave blank only for local development.
FILLCRAFT_API_KEY=

# Where the local SQLite backup + local asset/font mirror live inside the
# container. Mount a persistent volume at this path in Dokploy.
LOCAL_DATA_DIR=/app/data

# Canva Connect API (optional — only needed for automatic design import).
# Create an app at https://www.canva.com/developers to get these.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
