# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# Supabase — required, no local fallback exists.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret n8n must send as the "x-api-key" header when calling
# /api/designs/:id/autofill, /api/designs/:id/preview, and /api/images/normalize.
# Leave blank only for local development.
FILLCRAFT_API_KEY=

# Where uploaded custom-font files are cached locally. Mount a persistent
# volume at this path in Dokploy.
LOCAL_DATA_DIR=/app/data

# Canva Connect API (optional — only needed for "Import from Canva").
# Create an app at https://www.canva.com/developers to get these.
# Uses official OAuth + SVG/PNG export, NOT the public share-link scraping
# technique some other tools use — that's blocked by Canva's robots.txt.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
